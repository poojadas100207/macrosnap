# ==============================================================================
# MacroSnap Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to '.streamlit/secrets.toml' and fill in your actual credentials.
# IMPORTANT: NEVER commit '.streamlit/secrets.toml' to your Git repository!
# ==============================================================================

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY = "your-google-gemini-api-key-here"

# Model selection (defaults to gemini-3.8-flash)
GEMINI_MODEL = "gemini-flash-lite-latest"

# Gmail SMTP Configuration for sending free email digests
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below (never your real Google account password):
GMAIL_ADDRESS = "your-email@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# URL used by the clickable button in digest emails.
# Replace this with your deployed Streamlit URL in production.
MACROSNAP_URL = "http://localhost:8501"
